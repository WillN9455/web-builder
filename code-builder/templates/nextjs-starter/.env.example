# ============================================
# Environment Variables — {{PROJECT_NAME}}
# ============================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================

# ----- Database -----
# PostgreSQL connection string (local or managed, e.g. Neon, Supabase, Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/{{PROJECT_NAME}}?schema=public"

# Drizzle env — same as DATABASE_URL but can be a connection URI with pool settings
DRIZZLE_DATABASE_URL="${DATABASE_URL}"

# ----- Authentication (NextAuth / Auth.js v4) -----
# Secret for signing sessions and JWT tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# NextAuth URL — set to your production URL (e.g. https://app.yourdomain.com)
NEXTAUTH_URL="http://localhost:3000"

# ----- OAuth Providers (uncomment & fill as needed) -----

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth — create at https://github.com/settings/applications/new
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# Discord OAuth — create at https://discord.com/developers/applications
# DISCORD_CLIENT_ID="your-discord-client-id"
# DISCORD_CLIENT_SECRET="your-discord-client-secret"

# ----- Email (for password reset / magic link) -----
# Nodemailer config for SMTP (e.g. Resend, SendGrid, SES)
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="587"
# SMTP_USER="resend-username"
# SMTP_PASS="resend-password"

# ----- File Uploads (S3 / R2) -----
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="{{PROJECT_NAME}}-uploads"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"

# ----- Rate Limiting (Redis, optional) -----
REDIS_URL="redis://localhost:6379"

# ----- Feature Flags -----
# Enable debug logging in production (set to 'false' in production)
DEBUG_MODE="true"
