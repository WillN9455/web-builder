{
  "version": "0.1.0-draft",
  "revision": 1,
  "description": "Export contract for the Idea Hub web builder. Everything in framework/ is copied into a new project on idea creation. The launcher reads this file — not the filesystem — to learn what to export, which agents read which files, and where the UI writes back.",
  "export_root": "framework/",
  "stages": {
    "design": {
      "label": "Design",
      "folder": "design/",
      "skills": ["design/skills/accessibility-guidelines.md", "design/skills/ui-best-practices.md"],
      "config": ["design/config/design-rules.md"],
      "agents": ["design/agents/design-agent.md"],
      "ui_write_back": "Design tab → Rules half",
      "downstream": "design tokens, component specs, and state docs are stage OUTPUTS and live in the project's own design-system workspace, not in the export unit"
    },
    "build": {
      "label": "Build",
      "folder": "build/",
      "skills": [
        "build/skills/coding-guidelines.md",
        "build/skills/code-quality.md",
        "build/skills/security.md",
        "build/skills/feature-fidelity.md"
      ],
      "config": ["build/config/config-rules.md", "build/config/build-rules.md"],
      "agents": ["build/agents/code-agents.md"],
      "templates": ["build/templates/nextjs-starter/"],
      "ui_write_back": "Build tab → Rules half"
    },
    "qa": {
      "label": "QA + Review",
      "folder": "qa/",
      "skills": ["qa/skills/testing-guidelines.md"],
      "config": ["qa/config/test-rules.md"],
      "agents": ["qa/agents/qa-agent.md", "qa/agents/reviewer-agent.md"],
      "ui_write_back": "QA tab → Rules half"
    }
  },
  "shared": {
    "skills": ["shared/skills/general-best-practices.md"],
    "consumers": ["design", "build", "qa"]
  },
  "outside_export_root": {
    "note": "Referenced at export time but not yet relocated. Debate item.",
    "prd_templates": "PRD/templates/",
    "workflows": "workflows/"
  }
}