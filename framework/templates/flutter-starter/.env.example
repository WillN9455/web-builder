# {{PROJECT_NAME}} — build-time configuration template.
#
# Flutter is a CLIENT runtime: everything compiled into the binary is readable
# by anyone who installs the app. There is no server-side .env, so secrets do
# NOT belong here (shared security body §9 / ../../../shared/skills/security.md).
#
# Values are supplied at build time, never read from a file at runtime:
#
#   flutter run   --dart-define=API_BASE_URL=https://api.example.com
#   flutter build --dart-define=API_BASE_URL=https://api.example.com \
#                 --dart-define=ENVIRONMENT=production
#
# Read them in Dart via String.fromEnvironment:
#
#   const baseUrl = String.fromEnvironment('API_BASE_URL');
#
# Rules:
# - Anything here is PUBLIC. Only endpoint URLs, environment names, feature
#   flags and public client keys (e.g. a Supabase anon key) may be listed.
# - Never list a service-role key, database password, signing key or any
#   credential that grants write/privilege access. Put privileged calls behind
#   a server-side BFF and call that from the app instead
#   (see ../../build/config/config-rules.md §API Communication).
# - Secrets for the backend live in the host secrets store, not in this file.

API_BASE_URL=
ENVIRONMENT=development
